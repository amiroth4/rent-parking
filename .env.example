# NeonDB PostgreSQL connection strings
# Use the pooled connection string for DATABASE_URL (with ?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Use the direct (non-pooled) connection string for migrations
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Session JWT secret (generate a random 32+ character string)
JWT_SECRET="replace-with-a-strong-32-character-random-secret"

# Public App URL (used for links & metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Provider: "gmail" | "resend" | "console"
# Use "console" during local dev if you want OTPs printed in the terminal
EMAIL_PROVIDER="gmail"
EMAIL_FROM="RentParking <yourname@gmail.com>"

# Gmail SMTP (requires a 16-char Google App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="yourname@gmail.com"
SMTP_PASS="xxxx-xxxx-xxxx-xxxx"

# Ready for future Resend switch (set EMAIL_PROVIDER="resend" and add key)
RESEND_API_KEY=""

# Initial Super Admin email (used by prisma/seed.ts)
SUPER_ADMIN_EMAIL="admin@example.com"
